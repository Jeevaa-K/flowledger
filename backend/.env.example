# ── Required ─────────────────────────────────────────────────
# Random string, 32+ characters (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_string_of_32_plus_chars
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Only needed if a frontend on ANOTHER origin calls this API (comma-separated).
# Same-origin use (frontend served by this server) needs nothing here.
ALLOWED_ORIGINS=

# ── Production database TLS (NODE_ENV=production) ────────────
# Certificates are verified by default. Adjust only if your host needs it:
#   DB_SSL=false                      # no TLS (e.g. Render internal database URL)
#   DB_SSL_CA=<PEM text, \n for newlines>   # trust a specific CA
#   DB_SSL_REJECT_UNAUTHORIZED=false  # last resort: TLS without verification
# Session cookie is Secure in production. Only for testing a prod build on http://localhost:
#   COOKIE_SECURE=false

# ── AI (optional — AI features are disabled without a key) ───
GROQ_API_KEY=your_groq_api_key_here
# Override models when Groq retires one (see console.groq.com/docs/deprecations)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── Langfuse tracing (optional) ──────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-your_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
