# ── Required ─────────────────────────────────────────────────
# Random string, 32+ characters (e.g. run: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME

# ── Demo Account (optional) ──────────────────────────────────
# Set ENABLE_DEMO=true to enable the /api/auth/demo endpoint
ENABLE_DEMO=false
DEMO_EMAIL=demo@flowledger.app
# Required when ENABLE_DEMO=true (no hardcoded default password):
DEMO_PASSWORD=your_secure_demo_password_here

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Only needed if a frontend on ANOTHER origin calls this API (comma-separated).
# Same-origin use (frontend served by this server) needs nothing here.
ALLOWED_ORIGINS=

# ── Production database TLS (NODE_ENV=production) ────────────
# Certificates are verified by default. Adjust only if your host needs it:
#   DB_SSL=false                      # no TLS (e.g. Render internal database URL)
#   DB_SSL_CA=<PEM text, \n for newlines>   # trust a specific CA
#   DB_SSL_REJECT_UNAUTHORIZED=false  # last resort: TLS without verification
# Session cookie is Secure in production. Only for testing a prod build on http://localhost:
#   COOKIE_SECURE=false

# ── AI (optional — AI features are disabled without a key) ───
# Get a 100% free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Open-source models supported on Groq:
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── Langfuse tracing (off by default — sends AI traces externally) ──
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
